# ---- Required ----------------------------------------------------------------
# Exact origins of the websites allowed to embed the widget (comma-separated, https only).
ALLOWED_ORIGINS=https://www.example.com

# Model: any OpenAI-compatible API. Examples:
#   OpenAI      LLM_BASE_URL=https://api.openai.com/v1          LLM_MODEL=gpt-4o-mini
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1       LLM_MODEL=openai/gpt-4o-mini
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1     LLM_MODEL=llama-3.3-70b-versatile
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1          LLM_MODEL=llama3.1   (no key needed)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# LLM_MAX_TOKENS=400

# Or an OpenClaw gateway bridge (text-only; the server injects knowledge-base context itself).
# The bridge agent MUST have no tools (no exec, files, browser or messaging): visitors are untrusted.
# LLM_PROVIDER=openclaw
# OPENCLAW_BRIDGE_URL=
# OPENCLAW_BRIDGE_TOKEN=
# OPENCLAW_AGENT=main
# OPENCLAW_PURPOSE=website_chat
# OPENCLAW_TIMEOUT_SECONDS=90

# Experimental, local only: visitors sign in with ChatGPT and use their own plan.
# LLM_PROVIDER=chatgpt
# CHATGPT_MODEL=gpt-5.6-luna

# ---- Your business -----------------------------------------------------------
BOT_NAME=Assistant
KNOWLEDGE_BASE_PATH=examples/knowledge-base.md
# SYSTEM_PROMPT_FILE=prompt.txt   (use {bot_name} as a placeholder)

# ---- Lead capture (optional) -------------------------------------------------
# Confirmed leads are POSTed here, signed with HMAC-SHA256. See docs/webhooks.md.
# LEAD_WEBHOOK_URL=https://hooks.example.com/leads
# LEAD_WEBHOOK_SECRET=   (at least 32 random characters: openssl rand -hex 32)

# ---- Abuse protection (optional) ---------------------------------------------
# TURNSTILE_SECRET_KEY=          Cloudflare Turnstile; pass the token to the widget as turnstileToken
# TRUST_PROXY_HEADERS=false      set true ONLY behind your own reverse proxy
# CLIENT_IP_HEADER=x-forwarded-for   header your proxy sets (right-most entry used). Behind Cloudflare: cf-connecting-ip
# MAX_CONNECTIONS_PER_IP=3
# MAX_CONNECTIONS_TOTAL=1000
# RATE_LIMIT_MESSAGES=20
# RATE_LIMIT_WINDOW_SECONDS=300
# MAX_MESSAGE_CHARS=2000
# MAX_TURNS_PER_CONNECTION=50
# MAX_HISTORY_MESSAGES=12
# IDLE_TIMEOUT_SECONDS=600
# MAX_SESSION_SECONDS=3600

# ---- Server --------------------------------------------------------------------
# HOST=127.0.0.1
# PORT=8787
# DEV_MODE=true   local only: serves a demo page and allows MOCK_LLM=true
